<mxfile host="app.diagrams.net">
  <diagram id="minimal-watchdog" name="Minimal Architecture">
    <mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;DevOps Incident Watchdog: High-Level Minimal Architecture&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#0F172A;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="450" height="30" as="geometry" />
        </mxCell>

        <!-- 1. Storefront -->
        <mxCell id="box1" value="&lt;b&gt;1. Client Storefront&lt;/b&gt;&lt;br&gt;FlashMart SPA (VIT Hub)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=12;fontColor=#1E3A8A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- 2. Target Microservice -->
        <mxCell id="box2" value="&lt;b&gt;2. Flask Microservice&lt;/b&gt;&lt;br&gt;AWS Lambda (Python 3.12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=12;fontColor=#991B1B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- 3. CloudWatch -->
        <mxCell id="box3" value="&lt;b&gt;3. Amazon CloudWatch&lt;/b&gt;&lt;br&gt;Filter: [CRITICAL_ALERT]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=12;fontColor=#9A3412;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="490" y="90" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- 4. Watchdog Lambda -->
        <mxCell id="box4" value="&lt;b&gt;4. Watchdog Lambda&lt;/b&gt;&lt;br&gt;Serverless SRE Triage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;fontSize=12;fontColor=#6B21A8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="720" y="90" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- 5. Amazon S3 -->
        <mxCell id="box5" value="&lt;b&gt;5. Amazon S3 Vault&lt;/b&gt;&lt;br&gt;Forensic JSON Dump" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FEFCE8;strokeColor=#EAB308;strokeWidth=2;fontSize=12;fontColor=#854D0E;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="725" y="230" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- 6. GitHub Agile & CI/CD -->
        <mxCell id="box6" value="&lt;b&gt;6. GitHub Sprint Board&lt;/b&gt;&lt;br&gt;Issue #1 &amp; GitHub Actions CI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontSize=12;fontColor=#166534;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="255" y="235" width="180" height="75" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="1. Order Request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;fontSize=11;fontColor=#1E40AF;fontFamily=Helvetica;" edge="1" parent="1" source="box1" target="box2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="2. Crash Telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EF4444;strokeWidth=2;fontSize=11;fontColor=#991B1B;fontFamily=Helvetica;" edge="1" parent="1" source="box2" target="box3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="3. Log Trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F97316;strokeWidth=2;fontSize=11;fontColor=#9A3412;fontFamily=Helvetica;" edge="1" parent="1" source="box3" target="box4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="4. Archive S3 Evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EAB308;strokeWidth=2;fontSize=11;fontColor=#854D0E;fontFamily=Helvetica;" edge="1" parent="1" source="box4" target="box5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="5. Mint Issue #1 (DoD)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#A855F7;strokeWidth=2;fontSize=11;fontColor=#6B21A8;fontFamily=Helvetica;" edge="1" parent="1" source="box4" target="box6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="272" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e6" value="6. Fixes #1 (Auto-Close)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#22C55E;strokeWidth=2;fontSize=11;fontColor=#166534;fontFamily=Helvetica;" edge="1" parent="1" source="box6" target="box2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>